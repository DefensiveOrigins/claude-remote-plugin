{
  "mcpServers": {
    "remote-prompt": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${CLAUDE_PLUGIN_ROOT}/scripts/rp_client.ps1",
        "-Mcp"
      ],
      "env": {
        "RP_HOST": "${RP_HOST:-127.0.0.1}",
        "RP_PORT": "${RP_PORT:-81}",
        "RP_TOKEN": "${RP_TOKEN:-}",
        "RP_CLIENT_NAME": "${RP_CLIENT_NAME:-}",
        "RP_TIMEOUT": "${RP_TIMEOUT:-600}"
      }
    }
  }
}
